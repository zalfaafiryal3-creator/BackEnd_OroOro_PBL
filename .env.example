# Salin menjadi .env. Gunakan database MySQL yang sudah dibuat terlebih dahulu.
# Ganti USER dan PASSWORD dengan kredensial MySQL lokal.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/pasar_oro_oro_dowo"
# Ganti dengan nilai acak yang panjang. Jangan gunakan nilai contoh ini di production.
JWT_SECRET=ganti-dengan-rahasia-acak-yang-panjang
PORT=4000
# Alamat frontend yang boleh memanggil API (pisahkan dengan koma). localhost sudah otomatis boleh saat development.
CORS_ORIGIN=http://localhost:3000