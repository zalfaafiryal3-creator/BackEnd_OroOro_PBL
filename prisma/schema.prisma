generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("seller") // "admin" atau "seller"
  createdAt    DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  type      String // "store" (ulasan toko) atau "market" (ulasan pasar)
  name      String   @default("Anonim")
  date      String   @default("")
  text      String
  rating    Int      @default(5)
  createdAt DateTime @default(now())

  @@index([type])
}
