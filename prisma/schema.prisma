generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("seller") // "admin" atau "seller"
  createdAt    DateTime @default(now())
  stores       Store[]
  bookmarks    Bookmark[]
}

model Review {
  id            Int          @id @default(autoincrement())
  type          String       // "store" (ulasan toko) atau "market" (ulasan pasar)
  marketId      Int?         @map("market_id")
  name          String       @default("Anonim")
  date          String       @default("")
  text          String
  rating        Int          @default(5)
  overallRating Int?         @map("overall_rating")
  storeId       Int?         @map("store_id")
  store         Store?       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  isPublic      Boolean      @default(true) @map("is_public")
  isDeleted     Boolean      @default(false) @map("is_deleted")
  createdAt     DateTime     @default(now())
  photos        ReviewPhoto[]

  @@index([type])
  @@index([marketId])
  @@index([storeId, type, isPublic, isDeleted])
  @@index([isPublic, isDeleted])
}

model ReviewPhoto {
  id        Int      @id @default(autoincrement())
  reviewId   Int      @map("review_id")
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url       String
  isPublic  Boolean  @default(true) @map("is_public")
  createdAt DateTime @default(now())

  @@index([reviewId])
  @@index([isPublic])
}

model Category {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  stores Store[]
}

model Store {
  id              Int       @id @default(autoincrement())
  slug            String    @unique
  name            String
  ownerName       String    @default("")
  categoryId      Int
  category        Category  @relation(fields: [categoryId], references: [id])
  zone            String    @default("")
  status          String    @default("menunggu_verifikasi") // buka, tutup, menunggu_verifikasi
  openTime        String?   @default("06:00")
  closeTime       String?   @default("17:00")
  sourceMobileId  String?   @unique
  establishedYear Int?
  phone           String    @default("")
  email           String    @default("")
  description     String    @default("")
  bannerUrl       String?
  logoUrl         String?
  sellerId        Int?
  seller          User?     @relation(fields: [sellerId], references: [id])
  products        Product[]
  reviews         Review[]
  createdAt       DateTime  @default(now())

  @@index([categoryId])
}

model Product {
  id          Int     @id @default(autoincrement())
  storeId     Int
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  price       Int     @default(0)
  description String  @default("")
  photoUrl    String?
  bookmarks   Bookmark[]
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}
