generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("seller") // "admin" atau "seller"
  createdAt    DateTime @default(now())
  stores       Store[]
}

model Review {
  id        Int      @id @default(autoincrement())
  type      String // "store" (ulasan toko) atau "market" (ulasan pasar)
  name      String   @default("Anonim")
  date      String   @default("")
  text      String
  rating    Int      @default(5)
  createdAt DateTime @default(now())

  @@index([type])
}

model Category {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  stores Store[]
}

model Store {
  id              Int       @id @default(autoincrement())
  slug            String    @unique
  name            String
  ownerName       String    @default("")
  categoryId      Int
  category        Category  @relation(fields: [categoryId], references: [id])
  zone            String    @default("")
  status          String    @default("menunggu_verifikasi") // buka, tutup, menunggu_verifikasi
  openTime        String    @default("06:00")
  closeTime       String    @default("17:00")
  establishedYear Int?
  phone           String    @default("")
  email           String    @default("")
  description     String    @default("")
  bannerUrl       String?
  logoUrl         String?
  sellerId        Int?
  seller          User?     @relation(fields: [sellerId], references: [id])
  products        Product[]
  createdAt       DateTime  @default(now())

  @@index([categoryId])
}

model Product {
  id          Int     @id @default(autoincrement())
  storeId     Int
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  price       Int     @default(0)
  description String  @default("")
  photoUrl    String?
}
